{
  "name": "@local/dsh-sound",
  "version": "0.2.0",
  "private": true,
  "description": "DSH の各種挙動を効果音とデスクトップ通知で知らせるプラグイン",
  "license": "MIT",
  "author": "cwd514",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "bundle",
    "plugin",
    "notification",
    "desktop-notification",
    "sound",
    "web-audio"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cwd514/dsh-sound-notifications.git"
  },
  "homepage": "https://github.com/cwd514/dsh-sound-notifications#readme",
  "bugs": {
    "url": "https://github.com/cwd514/dsh-sound-notifications/issues"
  },
  "type": "module",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "icon.svg",
    "cordis.patch.yml",
    "locale/*.json"
  ],
  "scripts": {
    "check": "node --check index.js && node --check client.js",
    "test": "node test/smoke.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    }
  }
}
